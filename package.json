{
  "name": "mentis-dashboard-v3",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.10.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "next dev -p 7253 -H 0.0.0.0",
    "build": "node scripts/check-api-guard.mjs && next build",
    "start": "next start -p 7253 -H 0.0.0.0",
    "serve": "next build && next start -p 7253",
    "share": "node scripts/share.mjs",
    "share:on": "node scripts/share.mjs on",
    "share:off": "node scripts/share.mjs off",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "demo:seed": "node scripts/seed-demo.mjs",
    "demo:clean": "bash scripts/demo/demo-play.sh clean",
    "demo:play": "bash scripts/demo/demo-play.sh",
    "demo": "bash scripts/demo/demo-play.sh reset && ORCHESTRATION_META_PATH=\"$PWD/.demo-meta\" next dev -p 7253",
    "check:api": "node scripts/check-api-guard.mjs"
  },
  "dependencies": {
    "@floating-ui/dom": "1.8.0",
    "lucide-react": "1.76.0",
    "mermaid": "^11.16.0",
    "next": "16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "yaml": "2.8.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "typescript": "^5"
  }
}
